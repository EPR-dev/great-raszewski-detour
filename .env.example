# Copy to .env.local for local secrets. Never commit real keys.
# Leave these unset to run in local demo mode (browser localStorage).

# Supabase project URL and the anon (public) key only.
# The service role key must stay on the server / out of this repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional basemap. Defaults to OpenStreetMap tiles, which render without an API key.
# CARTO's public Voyager URL currently returns "API key required" watermarks.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional place search. Defaults to the public Photon demo (search-as-you-type, fair use).
# Set to off to disable remote search. Manual pins still work.
# If this host is nominatim.openstreetmap.org, the app uses search-on-submit
# because Nominatim forbids autocomplete.
# VITE_GEOCODE_URL=https://photon.komoot.io/api/
# VITE_GEOCODE_URL=off
